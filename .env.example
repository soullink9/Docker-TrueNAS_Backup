# The container's settings. Copy to truenas-backup.env (the env_file in the
# compose file), fill in, and keep it private: it holds API keys and the IPMI
# password. Never commit it. Every setting: docs/setup.md

# ---- Schedule ----
# BACKUP_SCHEDULE and TZ are in the compose file (default: Mondays at 1:00 AM).
# true = also run once right after the container starts
RUN_ON_START=false

# ---- The backup box ----
# Its TrueNAS IP (the one the replication SSH connection uses)
BACKUP_HOST=192.168.1.20
# Friendly name for notifications
BACKUP_NAME=backup TrueNAS
# Port that answers once it has booted (22 = SSH)
CHECK_PORT=22

# ---- Power on / shut down ----
# Every method is optional: fill in the ones you have. You need at least one
# way to power on (ipmi, wol) and one way to shut down (api, ipmi).
# Configured methods are tried in these orders until one works:
POWER_ON_ORDER=ipmi,wol
POWER_OFF_ORDER=api,ipmi

# IPMI (BMC address, not the TrueNAS address). Leave all three empty to skip.
IPMI_HOST=
# A BMC user with Operator privilege
IPMI_USER=
IPMI_PASSWORD=

# Wake-on-LAN: the backup box's network port. Empty = skip.
WOL_MAC=
WOL_BROADCAST=192.168.1.255

# The backup box's own TrueNAS API, used to shut it down cleanly.
# Backup box: user menu (top right) > API Keys > Add. Empty = skip.
BACKUP_TRUENAS_URL=wss://192.168.1.20/api/current
BACKUP_TRUENAS_API_KEY=
# false = accept the backup box's self-signed certificate
BACKUP_TRUENAS_VERIFY_TLS=false

# ---- The primary's TrueNAS API (runs the replication; required) ----
# wss:// only: TrueNAS revokes an API key sent over plain ws://.
TRUENAS_URL=wss://127.0.0.1/api/current
# Primary: user menu (top right) > API Keys > Add
TRUENAS_API_KEY=
# false = accept TrueNAS's self-signed certificate
TRUENAS_VERIFY_TLS=false

# ---- Replication ----
# Task names exactly as in Data Protection > Replication Tasks, comma-separated
REPLICATION_TASKS=Primary to backup
REPLICATION_RETRIES=1
RETRY_WAIT=300
REPLICATION_TIMEOUT=43200

# ---- Timing (seconds) ----
BOOT_TIMEOUT=900
SETTLE_SECONDS=120
SHUTDOWN_TIMEOUT=900

# ---- Behaviour ----
# true = power the backup box off even after a failed replication
SHUTDOWN_ON_FAILURE=false
# true = power it off at the end even if it was already on when the run started
SHUTDOWN_IF_ALREADY_ON=false

# ---- Home Assistant ----
HA_WEBHOOK_URL=http://192.168.1.10:8123/api/webhook/truenas-backup-CHANGE-ME
# false only for HTTPS with a self-signed certificate
HA_VERIFY_TLS=true
