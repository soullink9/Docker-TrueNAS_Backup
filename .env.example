# Copy to .env, fill in, and keep it private (it holds the IPMI password and
# a TrueNAS API key). Never commit .env. Every setting: docs/setup.md

# ---- Schedule ----
# BACKUP_SCHEDULE and TZ are in the compose file (default: Mondays at 1:00 AM).
# true = also run once right after the container starts
RUN_ON_START=false

# ---- The backup box ----
# Its TrueNAS IP (the one the replication SSH connection uses)
BACKUP_HOST=192.168.1.20
# Friendly name for notifications
BACKUP_NAME=backup TrueNAS
# Port that answers once it has booted (22 = SSH)
CHECK_PORT=22

# ---- Power on/off: IPMI (BMC address, not the TrueNAS address) ----
IPMI_HOST=192.168.1.21
# A BMC user with Operator privilege
IPMI_USER=backupctl
IPMI_PASSWORD=

# ---- Power on fallback: Wake-on-LAN (empty = off) ----
WOL_MAC=
WOL_BROADCAST=192.168.1.255

# ---- The primary's TrueNAS API (runs the replication) ----
# wss:// only: TrueNAS revokes an API key sent over plain ws://.
TRUENAS_URL=wss://127.0.0.1/api/current
# Primary: user menu (top right) > API Keys > Add
TRUENAS_API_KEY=
# false = accept TrueNAS's self-signed certificate
TRUENAS_VERIFY_TLS=false

# ---- Replication ----
# Task names exactly as in Data Protection > Replication Tasks, comma-separated
REPLICATION_TASKS=Primary to backup
REPLICATION_RETRIES=1
RETRY_WAIT=300
REPLICATION_TIMEOUT=43200

# ---- Timing (seconds) ----
BOOT_TIMEOUT=900
SETTLE_SECONDS=120
SHUTDOWN_TIMEOUT=900

# ---- Behaviour ----
# true = power the backup box off even after a failed replication
SHUTDOWN_ON_FAILURE=false
# true = power it off at the end even if it was already on when the run started
SHUTDOWN_IF_ALREADY_ON=false

# ---- Home Assistant ----
HA_WEBHOOK_URL=http://192.168.1.10:8123/api/webhook/truenas-backup-CHANGE-ME
# false only for HTTPS with a self-signed certificate
HA_VERIFY_TLS=true
